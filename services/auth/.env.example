# Токен бота від @BotFather (той самий бот, що відкриває Mini App)
BOT_TOKEN=
# Довгий випадковий рядок (мінімум 32 символи): python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Для локального запуску без Docker. У Docker Compose хост = postgres, порт 5432
DATABASE_URL=postgresql://user:password@localhost:5433/proactive_ed
PORT=8001
# Необов'язково:
JWT_TTL_SECONDS=86400
INIT_DATA_MAX_AGE_SECONDS=86400
